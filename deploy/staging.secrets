# Staging: env var name = Secret Manager secret name. Values never go in git.
# Create or update them with: scripts/push-secrets.sh staging .env.staging
SMARTSHEET_API_TOKEN=staging-smartsheet-api-token
WEBHOOK_SECRET=staging-webhook-secret
# Staff access (kept here rather than in git because it lists personal emails).
STAFF_EMAILS=staging-staff-emails
STAFF_ROLES_MAP=staging-staff-roles-map
