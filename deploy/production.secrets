# Production: env var name = Secret Manager secret name. Values never go in git.
# Create or update them with: scripts/push-secrets.sh production .env.production
SMARTSHEET_API_TOKEN=prod-smartsheet-api-token
WEBHOOK_SECRET=prod-webhook-secret
STAFF_EMAILS=prod-staff-emails
STAFF_ROLES_MAP=prod-staff-roles-map
GEMINI_API_KEY=prod-gemini-api-key
# Uncomment the SMS provider chosen for production:
# CLICKSEND_USERNAME=prod-clicksend-username
# CLICKSEND_API_KEY=prod-clicksend-api-key
# TWILIO_ACCOUNT_SID=prod-twilio-account-sid
# TWILIO_AUTH_TOKEN=prod-twilio-auth-token
