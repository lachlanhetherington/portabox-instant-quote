rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    // Staff = verified account (Google, or passwordless email link, which Firebase
    // reports as provider "password") carrying the custom claim { staff: true }.
    // Anonymous and any other sign-ins never qualify. Roles come from the `role` claim.
    function isStaff() {
      return isSignedIn()
        && request.auth.token.staff == true
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'password'];
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isValidMessage(data) {
      return data.from is string && data.from.size() <= 32 &&
             data.to is string && data.to.size() <= 32 &&
             data.body is string && data.body.size() <= 10000 &&
             data.contactId is string && data.contactId.size() <= 128 &&
             data.direction in ['inbound', 'outbound'] &&
             data.timestamp is string;
    }
    function incoming() { return request.resource.data; }

    match /{document=**} { allow read, write: if false; }

    match /contacts/{contactId} {
      allow read: if isStaff();

      match /messages/{messageId} {
        allow read: if isStaff();
        allow create: if isStaff() && isValidId(contactId) && isValidId(messageId) && isValidMessage(incoming());
        allow update, delete: if false;
      }
    }
  }
}
