# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE MAPS API KEY: Required for Google Maps Platform routing, geocoding and map rendering.
# Browser key: restrict it in Google Cloud by HTTP referrer and to the Maps APIs you use.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_BROWSER_KEY"

# TWILIO SMS CONFIGURATION (Optional - app falls back to simulated dispatch if omitted):
# Obtain from https://console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_PHONE_NUMBER="+61488880123"

# CLICKSEND AUSTRALIA SMS GATEWAY CONFIGURATION:
# Obtain from ClickSend Dashboard > Developers > API Credentials (https://dashboard.clicksend.com)
CLICKSEND_USERNAME="your_clicksend_username"
CLICKSEND_API_KEY="your_clicksend_api_key"
CLICKSEND_FROM="Portabox"


# SERVER AUTH (required — /api routes reject all requests if unset):
# Comma-separated emails of staff allowed to call /api (must be Google/Firebase verified emails).
# Alternatively give a Firebase user the custom claim { staff: true }.
STAFF_EMAILS=admin@example.com
# Roles for those emails: email:role,... Default: call_center.
#   ceo = Managing Director, manager = Office Manager, call_centre_supervisor = Call Centre Supervisor,
#   call_center = Call Centre Representative (also: driver, admin_pricing, warehouse)
# A Firebase custom claim { role: "..." } takes precedence.
STAFF_ROLES_MAP=admin@example.com:ceo
# MICROSOFT WORK-ACCOUNT SIGN-IN (optional; both needed to show "Sign in with Microsoft"):
# Tenant ID of the staff organisation's Microsoft Entra ID (Azure AD). The Azure app registration
# used by Firebase's Microsoft provider MUST be single-tenant ("this organizational directory only").
MICROSOFT_TENANT_ID=
# Email domains trusted from Microsoft sign-in (comma separated). Staff must still be in STAFF_EMAILS.
MICROSOFT_STAFF_DOMAINS=
# Shared secret appended as ?secret=... (or X-Webhook-Secret header) on ClickSend and Smartsheet webhook URLs.
WEBHOOK_SECRET=change-me-long-random
# Twilio webhooks are verified with TWILIO_AUTH_TOKEN + APP_URL (public base URL, no trailing slash).

# ENVIRONMENT: local (default) | staging | production.
# Production never fakes SMS or payments: it reports an error instead.
APP_ENV=local
# Who may show the app in a frame (CSP frame-ancestors). Default 'self'.
# FRAME_ANCESTORS="'self' https://portabox.com.au"
# Content-Security-Policy: report-only by default (reports go to /csp-report in the logs); "enforce" to block.
# CSP_MODE=enforce
# LOG_FORMAT=json|text  (default: json on Cloud Run, text locally)

# FIRESTORE (server and browser use the same database)
# Production: "(default)". Staging and local dev: "staging" (also the default when unset),
# so testing never uses production quote numbers or settings.
FIRESTORE_DATABASE_ID=staging
# Admin settings are stored per environment under adminSettings/<SETTINGS_ENV> (default: Cloud Run service name, else "local").
# SETTINGS_ENV=local
# First quote number a fresh database hands out (staging uses 900001).
# QUOTE_NUMBER_START=900001

# SMARTSHEET (server-side only; never sent from the browser)
SMARTSHEET_API_TOKEN=
# Sheet that finished quotes are added to (one row per container). Defaults to Dan's CRM sheet.
# Point staging/testing at a copy so test quotes don't land on the live sheet.
# SMARTSHEET_QUOTES_SHEET_ID=3517583962886020
# SMARTSHEET_QUOTES_ONLY=true   # staging: turn off the staff Smartsheet tools (they default to the live sheet)

# RATE LIMITS (optional overrides; defaults shown)
# RATE_LIMIT_API_PER_15MIN=600   # per IP, all /api routes
# RATE_LIMIT_SMS_PER_10MIN=30    # per staff user
# RATE_LIMIT_AI_PER_10MIN=60     # per staff user (Gemini, call summaries)
# RATE_LIMIT_QUOTE_NUMBERS_PER_10MIN=30  # per IP, new quote numbers
# RATE_LIMIT_QUOTE_SUBMIT_PER_10MIN=20   # per IP, finished quotes sent to the sheet
# TRUST_PROXY=1                  # reverse-proxy hops in front of the server
