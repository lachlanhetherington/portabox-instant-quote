# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE MAPS API KEY: Required for Google Maps Platform routing, geocoding and map rendering.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# TWILIO SMS CONFIGURATION (Optional - app falls back to simulated dispatch if omitted):
# Obtain from https://console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_PHONE_NUMBER="+61488880123"

# CLICKSEND AUSTRALIA SMS GATEWAY CONFIGURATION:
# Obtain from ClickSend Dashboard > Developers > API Credentials (https://dashboard.clicksend.com)
CLICKSEND_USERNAME="your_clicksend_username"
CLICKSEND_API_KEY="your_clicksend_api_key"
CLICKSEND_FROM="Portabox"

