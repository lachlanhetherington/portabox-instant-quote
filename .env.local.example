# Copy to .env.local. Nothing here is required for the quote flow to run.
# Only needed if you want the Stripe test-card UI to load the real Stripe.js:
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Where the header's back arrow goes from step 1 when the tab has no history
# to go back to (someone typed the URL in, or opened it in a new tab).
# Arriving from a link, the arrow returns them to the page they came from
# instead, so this is the fallback rather than the usual case.
#
# Points at the rebuilt site while it is in review. Set this in Vercel to
# override the default without a commit.
VITE_SITE_URL=https://portabox-website-ten.vercel.app/
